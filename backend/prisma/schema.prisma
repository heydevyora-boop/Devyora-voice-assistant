// Devyora central backend — relational model.
//
// Ownership: every row that holds user content carries `userId`, directly or
// one hop away, so a tenant filter can be enforced in one place.
//
// Deletion: user-authored content is soft-deleted (`deletedAt`) and purged by
// a retention job. Infrastructure rows that are meaningless without their
// parent cascade. AuditLog is append-only and survives account deletion with
// its user reference nulled, so the record of what happened is not destroyed.
//
// JSON is used only where the shape is genuinely open-ended — a provider
// payload, a captured plan, a preference document — never as a substitute for
// a relation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────── enums

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_DELETION
}

enum DevicePlatform {
  WINDOWS
  MACOS
  ANDROID
  IOS
  WEB
}

/// Purpose of a single-use token. One table rather than two keeps expiry,
/// consumption and cleanup in one place.
enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

/// How the user's words reached the assistant.
enum MessageSource {
  SPEECH
  TYPED
  SCRIPTED
}

/// Mirrors the frontend's ActionKind union.
enum ActionKind {
  NOTE_SAVE
  REMINDER_CREATE
  MESSAGE_WHATSAPP
  MESSAGE_TELEGRAM
  EMAIL_COMPOSE
  CALENDAR_EVENT
  APP_OPEN
  ASSISTANT_REPLY
}

/// How far the backend can take an action on its own.
/// LOCAL    — the server performs it and can verify the result.
/// ASSISTED — the server prepares it; the user completes it in another app.
/// ACCOUNT  — needs an authorised account connection.
enum ExecutionMode {
  LOCAL
  ASSISTED
  ACCOUNT
}

enum PendingActionStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

/// Mirrors the frontend's three-way ActionOutcome. HANDOFF is deliberately
/// distinct from COMPLETED: something verifiable happened, but the task is
/// not finished and must never be reported as success.
enum ExecutionStatus {
  COMPLETED
  HANDOFF
  FAILED
}

enum ReminderStatus {
  SCHEDULED
  FIRED
  DONE
  CANCELLED
}

/// Where a voice session's audio came from.
/// TEXT   — the device recognised speech itself and sent a transcript.
///          This is what the web client does today.
/// UPLOAD — the device sent a complete recording for the server to transcribe.
/// STREAM — audio arrived over a WebSocket while the user was speaking.
enum VoiceInputMode {
  TEXT
  UPLOAD
  STREAM
}

/// A voice session's state. Transitions are validated against an explicit
/// table in `voice-session.service.ts`; nothing moves a session by writing
/// this column directly.
enum VoiceSessionState {
  CREATED
  LISTENING
  TRANSCRIBING
  INTERPRETING
  AWAITING_CLARIFICATION
  AWAITING_CONFIRMATION
  QUEUED
  COMPLETED
  CANCELLED
  EXPIRED
  FAILED
}

/// How long a recording is kept.
/// DISCARD — deleted as soon as it has been transcribed. The default, and
///           what happens unless the user has asked for something else.
/// SESSION — kept until the voice session ends, so a retry does not need
///           the user to speak again.
/// RETAIN  — kept for the retention window the user chose.
/// What a stored audio file is.
/// INPUT  — the user's own speech, uploaded for recognition. Deleted as
///          soon as it has been transcribed unless retention says otherwise.
/// SPEECH — a synthesised reply. Not the user's voice, and kept only long
///          enough for the client to play it.
enum AudioKind {
  INPUT
  SPEECH
}

enum AudioRetention {
  DISCARD
  SESSION
  RETAIN
}

enum ConnectionProvider {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  TELEGRAM
  GMAIL
  GOOGLE_CALENDAR
}

enum ConnectionStatus {
  CONNECTED
  EXPIRED
  REVOKED
  ERROR
}

enum NotificationChannel {
  PUSH
  EMAIL
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  READ
}

/// Who caused an audited event. `AI` is recorded separately from `USER` so a
/// model-proposed action is never indistinguishable from a human one.
enum ActorType {
  USER
  SYSTEM
  AI
}

// ─────────────────────────────────────────────────────────── identity

model User {
  id           String     @id @default(uuid()) @db.Uuid
  /// Stored lower-cased by the application so the unique index is
  /// case-insensitive without requiring the citext extension.
  email        String     @unique @db.VarChar(320)
  passwordHash String
  displayName  String?    @db.VarChar(120)
  locale       String     @default("en-IN") @db.VarChar(16)
  timezone     String     @default("Asia/Kolkata") @db.VarChar(64)
  status       UserStatus @default(ACTIVE)

  /// Null until the address is proven. Nothing here fakes verification: it
  /// is set only when a real token issued to that address is presented.
  emailVerifiedAt DateTime?

  /// Account-level brute-force protection, alongside per-IP rate limiting.
  /// Counted on the account so an attacker rotating IPs is still slowed.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  /// Invalidates every access token issued before this moment. Bumped on a
  /// password change or a global logout, so tokens already in flight stop
  /// working without waiting for them to expire.
  tokensValidFrom DateTime @default(now())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  devices            Device[]
  sessions           Session[]
  conversations      Conversation[]
  commands           AssistantCommand[]
  pendingActions     PendingAction[]
  voiceSessions      VoiceSession[]
  audioAssets        AudioAsset[]
  notes              Note[]
  reminders          Reminder[]
  connectedAccounts  ConnectedAccount[]
  preference         UserPreference?
  notifications      Notification[]
  auditLogs          AuditLog[]
  verificationTokens VerificationToken[]

  @@index([deletedAt])
  @@index([status])
  @@map("users")
}

model Device {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  /// Server-generated opaque identifier the client stores and may present
  /// on a later login to reuse this device record. It is not a credential:
  /// it is only honoured after the password has been verified, and only
  /// when it belongs to the authenticating account.
  publicId   String         @unique @db.VarChar(64)
  platform   DevicePlatform
  name       String         @db.VarChar(120)
  /// Hardware class reported by the client: "phone", "laptop", "tablet",
  /// "desktop". Advisory only; never used for authorisation.
  deviceType String?        @db.VarChar(40)
  model      String?        @db.VarChar(120)
  appVersion String?        @db.VarChar(32)

  /// Push routing token. Null until the device registers for notifications.
  pushToken       String?
  /// Whether this device reports a native wake-word engine. Detection itself
  /// always runs on the device; the backend only records the capability.
  wakeWordCapable Boolean @default(false)

  lastSeenAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions      Session[]
  notifications Notification[]
  voiceSessions VoiceSession[]

  @@index([userId, revokedAt])
  @@index([lastSeenAt])
  @@map("devices")
}

model Session {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @db.Uuid
  deviceId  String  @db.Uuid
  ipAddress String? @db.Inet
  userAgent String?

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  device        Device         @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, endedAt])
  @@index([deviceId])
  @@map("sessions")
}

model RefreshToken {
  id        String @id @default(uuid()) @db.Uuid
  sessionId String @db.Uuid
  /// SHA-256 of the token. The plaintext is returned once and never stored.
  tokenHash String @unique @db.VarChar(64)

  expiresAt   DateTime
  /// Set when this token is rotated out, pointing at its replacement.
  /// Presenting a rotated token is treated as theft and revokes the family.
  rotatedToId String?   @db.Uuid
  revokedAt   DateTime?

  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Single-use tokens for email verification and password reset.
///
/// Only the hash is stored, exactly as for refresh tokens: a database leak
/// must not hand an attacker a working reset link.
model VerificationToken {
  id     String                @id @default(uuid()) @db.Uuid
  userId String                @db.Uuid
  type   VerificationTokenType

  /// SHA-256 of the token. The plaintext exists only in the delivered email.
  tokenHash String @unique @db.VarChar(64)

  /// The address the token was issued for. A later email change must not
  /// let an old token verify the new address.
  emailAtIssue String @db.VarChar(320)

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("verification_tokens")
}

// ─────────────────────────────────────────────────── assistant core

model Conversation {
  id     String  @id @default(uuid()) @db.Uuid
  userId String  @db.Uuid
  title  String? @db.VarChar(200)

  lastMessageAt DateTime?
  archivedAt    DateTime?
  deletedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
  commands AssistantCommand[]

  @@index([userId, lastMessageAt(sort: Desc)])
  @@index([userId, deletedAt])
  @@map("conversations")
}

model Message {
  id             String         @id @default(uuid()) @db.Uuid
  conversationId String         @db.Uuid
  role           MessageRole
  source         MessageSource?
  content        String

  /// Token accounting, for cost control and quota enforcement.
  tokensIn  Int?
  tokensOut Int?

  createdAt DateTime @default(now())

  conversation Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  commands     AssistantCommand[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// What the assistant understood from one utterance, kept separate from the
/// action it proposed so a misunderstanding can be audited on its own.
model AssistantCommand {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String  @db.Uuid
  conversationId String? @db.Uuid
  messageId      String? @db.Uuid

  rawText    String
  intent     String? @db.VarChar(80)
  /// Extracted entities. Open-ended by nature: the set differs per intent.
  entities   Json?
  confidence Float?

  /// Which interpreter produced this, so mock and live output stay separable.
  providerId String? @db.VarChar(40)
  latencyMs  Int?

  createdAt DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation  Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message       Message?       @relation(fields: [messageId], references: [id], onDelete: SetNull)
  pendingAction PendingAction?

  @@index([userId, createdAt(sort: Desc)])
  @@index([conversationId])
  @@map("assistant_commands")
}

/// A proposed action awaiting a decision.
///
/// `requiresConfirmation` is decided by server policy, never by the client and
/// never by the model, so approval cannot be skipped by a crafted request.
model PendingAction {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  commandId String @unique @db.Uuid

  kind          ActionKind
  executionMode ExecutionMode
  /// The resolved plan: title, target and the editable fields the user sees.
  /// Structured but open-ended per kind, so it is stored as a document.
  plan          Json

  requiresConfirmation Boolean             @default(true)
  status               PendingActionStatus @default(PENDING)

  /// Supplied by the client on approval. The unique constraint is what makes
  /// a replayed approval a no-op instead of a duplicate message.
  idempotencyKey String?   @unique @db.VarChar(100)
  expiresAt      DateTime
  decidedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  command    AssistantCommand  @relation(fields: [commandId], references: [id], onDelete: Cascade)
  executions ActionExecution[]

  @@index([userId, status])
  @@index([expiresAt])
  @@map("pending_actions")
}

model ActionExecution {
  id              String @id @default(uuid()) @db.Uuid
  pendingActionId String @db.Uuid
  attempt         Int    @default(1)

  status       ExecutionStatus
  /// Plain-language result shown to the user, in the executor's own words.
  detail       String
  /// Identifier returned by an external provider, where one exists.
  providerRef  String?         @db.VarChar(200)
  /// Structured provider response for debugging; shape differs per provider.
  providerMeta Json?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  pendingAction PendingAction @relation(fields: [pendingActionId], references: [id], onDelete: Cascade)

  @@unique([pendingActionId, attempt])
  @@index([status])
  @@map("action_executions")
}

// ───────────────────────────────────────────────────── capabilities

// ───────────────────────────────────────────────────────────────── voice

/// One spoken interaction, from activation to a settled outcome.
///
/// It owns the state machine the orb follows, and it is the join between a
/// device, a recording, a transcript and whatever the assistant proposed.
/// `deviceId` is not optional: a voice session always belongs to the device
/// that started it, which is what stops another device acting on it.
model VoiceSession {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @db.Uuid
  deviceId String @db.Uuid

  state     VoiceSessionState @default(CREATED)
  inputMode VoiceInputMode

  /// Set when the device reports that a local wake word started this,
  /// rather than a tap. Recorded for the user's own activity view; it is
  /// never treated as authentication.
  wakeWordTriggered Boolean @default(false)
  /// BCP-47 hint the client supplied, e.g. `hi-IN`. Advisory: a provider
  /// may detect something else, and the detected value wins.
  languageHint      String? @db.VarChar(24)

  /// The settled transcript. Partial text is pushed over the socket and
  /// never stored: an interim guess is not a record of what was said.
  transcript       String?
  detectedLanguage String? @db.VarChar(24)
  sttProviderId    String? @db.VarChar(40)
  /// Provider confidence, where the provider reports one.
  sttConfidence    Float?
  sttLatencyMs     Int?

  conversationId  String? @db.Uuid
  commandId       String? @db.Uuid
  pendingActionId String? @db.Uuid

  /// The reply text. Stored so a reconnecting client can be told the
  /// outcome without re-running anything.
  replyText   String?
  /// Normalised failure code, e.g. `audio_too_long`, `stt_timeout`. Never a
  /// provider message: those go to the log.
  failureCode String? @db.VarChar(40)

  /// Sequence of the last event emitted, so a reconnecting client can ask
  /// for everything after what it already has.
  lastEventSeq Int       @default(0)
  expiresAt    DateTime
  endedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device              @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  events VoiceSessionEvent[]
  audio  AudioAsset[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([deviceId, state])
  /// The expiry sweep reads this.
  @@index([expiresAt])
  @@map("voice_sessions")
}

/// Append-only log of what a session emitted.
///
/// This is what makes reconnection work without replaying the pipeline: a
/// client that dropped at sequence 4 asks for everything after 4. Partial
/// transcripts are deliberately absent — they are pushed live and are not
/// worth a row, nor worth keeping.
model VoiceSessionEvent {
  id             String @id @default(uuid()) @db.Uuid
  voiceSessionId String @db.Uuid
  /// Monotonic within a session, starting at 1.
  seq            Int
  type           String @db.VarChar(40)
  /// Event payload as it was sent to the client.
  payload        Json

  createdAt DateTime @default(now())

  session VoiceSession @relation(fields: [voiceSessionId], references: [id], onDelete: Cascade)

  @@unique([voiceSessionId, seq])
  @@index([voiceSessionId, seq])
  @@map("voice_session_events")
}

/// Metadata for a recording. The bytes are not here.
///
/// Audio lives on disk under a server-generated name and is deleted as soon
/// as it has been transcribed, unless the user asked for something else.
/// `storageKey` is null once the bytes are gone, so a row can say "this
/// existed and was deleted" without implying the audio is still readable.
model AudioAsset {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String  @db.Uuid
  voiceSessionId String? @db.Uuid

  kind       AudioKind @default(INPUT)
  mimeType   String    @db.VarChar(80)
  /// Extension-free opaque name on disk. Null once deleted.
  storageKey String?   @db.VarChar(128)
  byteSize   Int
  durationMs Int?
  sampleRate Int?
  /// SHA-256 of the bytes, so a duplicate upload is recognisable and an
  /// integrity problem is detectable without keeping the audio.
  checksum   String    @db.VarChar(64)

  retention   AudioRetention @default(DISCARD)
  /// When the retention sweep may remove it. Null means "at end of use".
  deleteAfter DateTime?
  deletedAt   DateTime?

  createdAt DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  session VoiceSession? @relation(fields: [voiceSessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([deletedAt])
  @@index([deleteAfter])
  @@map("audio_assets")
}

model Note {
  id     String  @id @default(uuid()) @db.Uuid
  userId String  @db.Uuid
  text   String
  pinned Boolean @default(false)

  /// Client-generated id. Lets an offline device create a note and lets the
  /// existing browser-stored notes import exactly once.
  clientId String? @db.VarChar(64)
  /// Monotonic counter for last-write-wins conflict handling.
  version  Int     @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId, deletedAt, updatedAt(sort: Desc)])
  @@map("notes")
}

model Reminder {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  text   String

  dueAt    DateTime
  /// Stored alongside dueAt so a reminder fires at the right wall-clock time
  /// even if the user travels.
  timezone String   @default("Asia/Kolkata") @db.VarChar(64)
  /// RFC 5545 recurrence rule, null for one-off reminders.
  rrule    String?  @db.VarChar(200)

  status  ReminderStatus @default(SCHEDULED)
  /// Queue job handle, so rescheduling can cancel the previous job.
  jobId   String?        @db.VarChar(100)
  firedAt DateTime?

  clientId String? @db.VarChar(64)
  version  Int     @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId, status, dueAt])
  @@index([status, dueAt])
  @@map("reminders")
}

/// An authorised third-party account.
///
/// Tokens are stored as ciphertext only and are never serialised into an API
/// response. `keyVersion` exists so the encryption key can be rotated without
/// a migration.
model ConnectedAccount {
  id       String             @id @default(uuid()) @db.Uuid
  userId   String             @db.Uuid
  provider ConnectionProvider

  /// The account identifier at the provider, for display and reconciliation.
  externalAccountId String?  @db.VarChar(200)
  displayName       String?  @db.VarChar(200)
  scopes            String[]

  accessTokenEnc  Bytes?
  refreshTokenEnc Bytes?
  keyVersion      Int       @default(1)
  expiresAt       DateTime?

  status    ConnectionStatus @default(CONNECTED)
  lastError String?
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One live connection per provider per user; revoked rows may accumulate.
  @@unique([userId, provider, revokedAt])
  @@index([userId, status])
  @@map("connected_accounts")
}

/// One row per user. Grouped documents rather than a column per setting,
/// because the frontend already treats these as three cohesive objects and
/// they change shape as features land.
model UserPreference {
  userId String @id @db.Uuid

  /// Spoken replies, confirmation timeout, assistant behaviour.
  assistant  Json @default("{}")
  /// Speech source, language, retention choices.
  voice      Json @default("{}")
  /// Orb palette, shape, size, glow, transparency, rim, motion.
  appearance Json @default("{}")
  /// Audio retention and telemetry consent.
  privacy    Json @default("{}")

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Notification {
  id       String  @id @default(uuid()) @db.Uuid
  userId   String  @db.Uuid
  deviceId String? @db.Uuid

  channel NotificationChannel @default(PUSH)
  type    String              @db.VarChar(60)
  title   String              @db.VarChar(200)
  body    String?
  /// Routing payload for the client (deep link, entity ids).
  payload Json?

  status        NotificationStatus @default(QUEUED)
  sentAt        DateTime?
  readAt        DateTime?
  failureReason String?

  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([status, createdAt])
  @@map("notifications")
}

/// Append-only. No update or delete path exists in application code.
///
/// `userId` is nullable and uses SetNull so that deleting an account
/// pseudonymises the trail rather than erasing the record of what happened.
model AuditLog {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String?   @db.Uuid
  deviceId  String?   @db.Uuid
  actorType ActorType @default(USER)

  action     String  @db.VarChar(80)
  resource   String? @db.VarChar(80)
  resourceId String? @db.VarChar(64)
  /// Request context: correlation id, outcome, non-sensitive parameters.
  metadata   Json?

  ipAddress String? @db.Inet
  userAgent String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([resource, resourceId])
  @@map("audit_logs")
}
