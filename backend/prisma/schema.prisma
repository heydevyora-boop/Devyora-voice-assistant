// Devyora central backend — relational model.
//
// Ownership: every row that holds user content carries `userId`, directly or
// one hop away, so a tenant filter can be enforced in one place.
//
// Deletion: user-authored content is soft-deleted (`deletedAt`) and purged by
// a retention job. Infrastructure rows that are meaningless without their
// parent cascade. AuditLog is append-only and survives account deletion with
// its user reference nulled, so the record of what happened is not destroyed.
//
// JSON is used only where the shape is genuinely open-ended — a provider
// payload, a captured plan, a preference document — never as a substitute for
// a relation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────── enums

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_DELETION
}

enum DevicePlatform {
  WINDOWS
  MACOS
  ANDROID
  IOS
  WEB
}

/// Purpose of a single-use token. One table rather than two keeps expiry,
/// consumption and cleanup in one place.
enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

/// How the user's words reached the assistant.
enum MessageSource {
  SPEECH
  TYPED
  SCRIPTED
}

/// Mirrors the frontend's ActionKind union.
enum ActionKind {
  NOTE_SAVE
  REMINDER_CREATE
  MESSAGE_WHATSAPP
  MESSAGE_TELEGRAM
  EMAIL_COMPOSE
  CALENDAR_EVENT
  APP_OPEN
  ASSISTANT_REPLY
}

/// How far the backend can take an action on its own.
/// LOCAL    — the server performs it and can verify the result.
/// ASSISTED — the server prepares it; the user completes it in another app.
/// ACCOUNT  — needs an authorised account connection.
enum ExecutionMode {
  LOCAL
  ASSISTED
  ACCOUNT
}

/// A proposed action's lifecycle. Transitions are validated against an
/// explicit table in `actions/pending-action.state.ts`; nothing moves a row
/// by writing this column directly.
///
/// REJECTED, EXPIRED and CANCELLED are terminal and permanently prevent
/// execution. That is the point of them: a user who said no, or who waited
/// too long, must not have the action run later by a retry or a reconnect.
enum PendingActionStatus {
  PENDING
  APPROVED
  EXECUTING
  EXECUTED
  FAILED
  REJECTED
  EXPIRED
  CANCELLED
}

/// What actually happened when a handler ran.
///
/// HANDOFF is deliberately distinct from COMPLETED: something verifiable
/// happened, but the task is not finished and must never be reported as
/// success. UNVERIFIED is the honest answer when a call may have taken
/// effect and the provider gave us no way to confirm it — see
/// `docs/action-engine.md` on exactly-once.
enum ExecutionStatus {
  /// Claimed and in flight. Written before the handler runs, so a
  /// concurrent duplicate collides on the idempotency key instead of
  /// executing twice.
  RUNNING
  /// Succeeded, and the result was read back.
  COMPLETED
  /// Prepared for the user to finish elsewhere. Not success.
  HANDOFF
  /// Some of the work took effect and some did not.
  PARTIAL
  /// May have taken effect; we cannot tell. Never reported as success.
  UNVERIFIED
  /// Did not take effect.
  FAILED
}

enum ReminderStatus {
  SCHEDULED
  SNOOZED
  FIRED
  DONE
  CANCELLED
}

/// Where a voice session's audio came from.
/// TEXT   — the device recognised speech itself and sent a transcript.
///          This is what the web client does today.
/// UPLOAD — the device sent a complete recording for the server to transcribe.
/// STREAM — audio arrived over a WebSocket while the user was speaking.
enum VoiceInputMode {
  TEXT
  UPLOAD
  STREAM
}

/// A voice session's state. Transitions are validated against an explicit
/// table in `voice-session.service.ts`; nothing moves a session by writing
/// this column directly.
enum VoiceSessionState {
  CREATED
  LISTENING
  TRANSCRIBING
  INTERPRETING
  AWAITING_CLARIFICATION
  AWAITING_CONFIRMATION
  QUEUED
  COMPLETED
  CANCELLED
  EXPIRED
  FAILED
}

/// How long a recording is kept.
/// DISCARD — deleted as soon as it has been transcribed. The default, and
///           what happens unless the user has asked for something else.
/// SESSION — kept until the voice session ends, so a retry does not need
///           the user to speak again.
/// RETAIN  — kept for the retention window the user chose.
/// What a stored audio file is.
/// INPUT  — the user's own speech, uploaded for recognition. Deleted as
///          soon as it has been transcribed unless retention says otherwise.
/// SPEECH — a synthesised reply. Not the user's voice, and kept only long
///          enough for the client to play it.
enum AudioKind {
  INPUT
  SPEECH
}

enum AudioRetention {
  DISCARD
  SESSION
  RETAIN
}

/// Where a note came from. Recorded because a note dictated while driving
/// and one typed deliberately deserve to be told apart in a list.
enum NoteSource {
  VOICE
  MANUAL
  IMPORT
}

/// What happened to one scheduled occurrence of a reminder.
///
/// DELIVERED means a notification was accepted by a transport, not that a
/// person saw it. There is no status meaning "the user read it" here; that
/// lives on the notification, where it can actually be observed.
enum OccurrenceStatus {
  SCHEDULED
  DELIVERED
  FAILED
  SKIPPED
  CANCELLED
}

enum ConnectionProvider {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  TELEGRAM
  GMAIL
  GOOGLE_CALENDAR
}

enum ConnectionStatus {
  CONNECTED
  EXPIRED
  REVOKED
  ERROR
}

enum NotificationChannel {
  PUSH
  EMAIL
  IN_APP
}

/// A notification's lifecycle.
///
/// SENT means a transport accepted it. It does **not** mean a device showed
/// it, and it certainly does not mean a person saw it — only READ comes
/// close to that, and only because a client reports it. Nothing here is
/// allowed to call scheduling "delivered".
enum NotificationStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  /// No transport exists for this user's devices, so it was never attempted.
  UNDELIVERABLE
  READ
}

/// Who caused an audited event. `AI` is recorded separately from `USER` so a
/// model-proposed action is never indistinguishable from a human one.
enum ActorType {
  USER
  SYSTEM
  AI
}

// ─────────────────────────────────────────────────────────── identity

model User {
  id           String     @id @default(uuid()) @db.Uuid
  /// Stored lower-cased by the application so the unique index is
  /// case-insensitive without requiring the citext extension.
  email        String     @unique @db.VarChar(320)
  passwordHash String
  displayName  String?    @db.VarChar(120)
  locale       String     @default("en-IN") @db.VarChar(16)
  timezone     String     @default("Asia/Kolkata") @db.VarChar(64)
  status       UserStatus @default(ACTIVE)

  /// Null until the address is proven. Nothing here fakes verification: it
  /// is set only when a real token issued to that address is presented.
  emailVerifiedAt DateTime?

  /// Account-level brute-force protection, alongside per-IP rate limiting.
  /// Counted on the account so an attacker rotating IPs is still slowed.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  /// Invalidates every access token issued before this moment. Bumped on a
  /// password change or a global logout, so tokens already in flight stop
  /// working without waiting for them to expire.
  tokensValidFrom DateTime @default(now())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  devices             Device[]
  sessions            Session[]
  conversations       Conversation[]
  commands            AssistantCommand[]
  pendingActions      PendingAction[]
  voiceSessions       VoiceSession[]
  audioAssets         AudioAsset[]
  actionExecutions    ActionExecution[]
  reminderOccurrences ReminderOccurrence[]
  syncCursors         SyncCursor[]
  notes               Note[]
  reminders           Reminder[]
  connectedAccounts   ConnectedAccount[]
  preference          UserPreference?
  notifications       Notification[]
  auditLogs           AuditLog[]
  verificationTokens  VerificationToken[]
  oauthStates         OAuthState[]

  @@index([deletedAt])
  @@index([status])
  @@map("users")
}

model Device {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  /// Server-generated opaque identifier the client stores and may present
  /// on a later login to reuse this device record. It is not a credential:
  /// it is only honoured after the password has been verified, and only
  /// when it belongs to the authenticating account.
  publicId   String         @unique @db.VarChar(64)
  platform   DevicePlatform
  name       String         @db.VarChar(120)
  /// Hardware class reported by the client: "phone", "laptop", "tablet",
  /// "desktop". Advisory only; never used for authorisation.
  deviceType String?        @db.VarChar(40)
  model      String?        @db.VarChar(120)
  appVersion String?        @db.VarChar(32)

  /// Push routing token. Null until the device registers for notifications.
  pushToken       String?
  /// Whether this device reports a native wake-word engine. Detection itself
  /// always runs on the device; the backend only records the capability.
  wakeWordCapable Boolean @default(false)

  lastSeenAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions       Session[]
  notifications  Notification[]
  voiceSessions  VoiceSession[]
  pendingActions PendingAction[]
  syncCursors    SyncCursor[]
  oauthStates    OAuthState[]

  @@index([userId, revokedAt])
  @@index([lastSeenAt])
  @@map("devices")
}

model Session {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @db.Uuid
  deviceId  String  @db.Uuid
  ipAddress String? @db.Inet
  userAgent String?

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  device        Device         @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, endedAt])
  @@index([deviceId])
  @@map("sessions")
}

model RefreshToken {
  id        String @id @default(uuid()) @db.Uuid
  sessionId String @db.Uuid
  /// SHA-256 of the token. The plaintext is returned once and never stored.
  tokenHash String @unique @db.VarChar(64)

  expiresAt   DateTime
  /// Set when this token is rotated out, pointing at its replacement.
  /// Presenting a rotated token is treated as theft and revokes the family.
  rotatedToId String?   @db.Uuid
  revokedAt   DateTime?

  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Single-use tokens for email verification and password reset.
///
/// Only the hash is stored, exactly as for refresh tokens: a database leak
/// must not hand an attacker a working reset link.
model VerificationToken {
  id     String                @id @default(uuid()) @db.Uuid
  userId String                @db.Uuid
  type   VerificationTokenType

  /// SHA-256 of the token. The plaintext exists only in the delivered email.
  tokenHash String @unique @db.VarChar(64)

  /// The address the token was issued for. A later email change must not
  /// let an old token verify the new address.
  emailAtIssue String @db.VarChar(320)

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("verification_tokens")
}

// ─────────────────────────────────────────────────── assistant core

model Conversation {
  id     String  @id @default(uuid()) @db.Uuid
  userId String  @db.Uuid
  title  String? @db.VarChar(200)

  lastMessageAt DateTime?
  archivedAt    DateTime?
  deletedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
  commands AssistantCommand[]

  @@index([userId, lastMessageAt(sort: Desc)])
  @@index([userId, deletedAt])
  @@map("conversations")
}

model Message {
  id             String         @id @default(uuid()) @db.Uuid
  conversationId String         @db.Uuid
  role           MessageRole
  source         MessageSource?
  content        String

  /// Token accounting, for cost control and quota enforcement.
  tokensIn  Int?
  tokensOut Int?

  createdAt DateTime @default(now())

  conversation Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  commands     AssistantCommand[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// What the assistant understood from one utterance, kept separate from the
/// action it proposed so a misunderstanding can be audited on its own.
model AssistantCommand {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String  @db.Uuid
  conversationId String? @db.Uuid
  messageId      String? @db.Uuid

  rawText    String
  intent     String? @db.VarChar(80)
  /// Extracted entities. Open-ended by nature: the set differs per intent.
  entities   Json?
  confidence Float?

  /// Which interpreter produced this, so mock and live output stay separable.
  providerId String? @db.VarChar(40)
  latencyMs  Int?

  createdAt DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation  Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message       Message?       @relation(fields: [messageId], references: [id], onDelete: SetNull)
  pendingAction PendingAction?

  @@index([userId, createdAt(sort: Desc)])
  @@index([conversationId])
  @@map("assistant_commands")
}

/// A proposed action awaiting a decision.
///
/// `requiresConfirmation` is decided by server policy, never by the client and
/// never by the model, so approval cannot be skipped by a crafted request.
model PendingAction {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  commandId String @unique @db.Uuid

  /// The registry entry this will run, e.g. `notes.create`. An action not in
  /// the registry cannot be named here, which is what stops a model's output
  /// becoming a call to something arbitrary.
  actionId String @db.VarChar(80)

  /// The device that asked. Not optional: a confirmation belongs to the
  /// device that raised it, and another device cannot execute it.
  deviceId       String  @db.Uuid
  /// The authenticated session, so a revoked session's pending work is
  /// traceable.
  sessionId      String? @db.Uuid
  /// The voice session, when the request came by speech.
  voiceSessionId String? @db.Uuid

  kind          ActionKind
  executionMode ExecutionMode
  /// The resolved plan: title, target and the editable fields the user sees.
  /// Structured but open-ended per kind, so it is stored as a document.
  plan          Json

  /// Parameters validated against the action's input schema. These are the
  /// values that will actually be used — the preview the user confirms is
  /// rendered from them, so they cannot drift from what runs.
  params Json

  requiresConfirmation Boolean             @default(true)
  status               PendingActionStatus @default(PENDING)

  /// Supplied by the client on approval. The unique constraint is what makes
  /// a replayed approval a no-op instead of a duplicate message.
  idempotencyKey String?   @unique @db.VarChar(100)
  expiresAt      DateTime
  decidedAt      DateTime?
  /// When the handler was claimed. Set in the same transaction that moves
  /// the row to EXECUTING, so a second claim sees it.
  startedAt      DateTime?
  finishedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  device     Device            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  command    AssistantCommand  @relation(fields: [commandId], references: [id], onDelete: Cascade)
  executions ActionExecution[]

  @@index([userId, status])
  @@index([deviceId, status])
  @@index([expiresAt])
  @@map("pending_actions")
}

/// The record of one attempt to carry out an action.
///
/// Written **before** the handler runs, with status RUNNING and a unique
/// idempotency key. That ordering is the duplicate guard: a concurrent or
/// replayed request collides on the key and is handed the existing record
/// instead of executing a second time.
///
/// Parameters are not stored here. `paramsDigest` identifies them without
/// keeping a second copy of a message the user wrote — the pending action
/// already holds the values, and once it is purged the message is gone
/// rather than living on in an execution log.
model ActionExecution {
  id              String @id @default(uuid()) @db.Uuid
  pendingActionId String @db.Uuid
  attempt         Int    @default(1)

  /// Denormalised from the pending action so an execution can be audited
  /// and scoped without a join, and still reads correctly if the pending
  /// action is later purged.
  userId    String  @db.Uuid
  deviceId  String? @db.Uuid
  sessionId String? @db.Uuid
  actionId  String  @db.VarChar(80)

  /// Unique across the table. This, not application logic, is what makes a
  /// duplicate impossible: the second insert fails.
  idempotencyKey String @unique @db.VarChar(200)
  /// SHA-256 of the validated parameters. A privacy-safe reference: enough
  /// to tell two attempts apart, not enough to reconstruct the content.
  paramsDigest   String @db.VarChar(64)

  status       ExecutionStatus
  /// Plain-language result shown to the user, in the executor's own words.
  detail       String
  /// True only when the effect was read back after the fact. False means
  /// the result is reported as unverified, never as success.
  verified     Boolean         @default(false)
  /// Normalised failure code, e.g. `provider_unavailable`. Never a provider
  /// message: those go to the log.
  failureCode  String?         @db.VarChar(40)
  /// The row this action created, where it created one.
  resultRef    String?         @db.VarChar(200)
  /// Identifier returned by an external provider, where one exists.
  providerRef  String?         @db.VarChar(200)
  /// Structured provider response for debugging; shape differs per provider.
  providerMeta Json?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  pendingAction PendingAction @relation(fields: [pendingActionId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pendingActionId, attempt])
  @@index([status])
  @@index([userId, startedAt(sort: Desc)])
  @@index([actionId, status])
  @@map("action_executions")
}

// ───────────────────────────────────────────────────── capabilities

// ───────────────────────────────────────────────────────────────── voice

/// One spoken interaction, from activation to a settled outcome.
///
/// It owns the state machine the orb follows, and it is the join between a
/// device, a recording, a transcript and whatever the assistant proposed.
/// `deviceId` is not optional: a voice session always belongs to the device
/// that started it, which is what stops another device acting on it.
model VoiceSession {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @db.Uuid
  deviceId String @db.Uuid

  state     VoiceSessionState @default(CREATED)
  inputMode VoiceInputMode

  /// Set when the device reports that a local wake word started this,
  /// rather than a tap. Recorded for the user's own activity view; it is
  /// never treated as authentication.
  wakeWordTriggered Boolean @default(false)
  /// BCP-47 hint the client supplied, e.g. `hi-IN`. Advisory: a provider
  /// may detect something else, and the detected value wins.
  languageHint      String? @db.VarChar(24)

  /// The settled transcript. Partial text is pushed over the socket and
  /// never stored: an interim guess is not a record of what was said.
  transcript       String?
  detectedLanguage String? @db.VarChar(24)
  sttProviderId    String? @db.VarChar(40)
  /// Provider confidence, where the provider reports one.
  sttConfidence    Float?
  sttLatencyMs     Int?

  conversationId  String? @db.Uuid
  commandId       String? @db.Uuid
  pendingActionId String? @db.Uuid

  /// The reply text. Stored so a reconnecting client can be told the
  /// outcome without re-running anything.
  replyText   String?
  /// Normalised failure code, e.g. `audio_too_long`, `stt_timeout`. Never a
  /// provider message: those go to the log.
  failureCode String? @db.VarChar(40)

  /// Sequence of the last event emitted, so a reconnecting client can ask
  /// for everything after what it already has.
  lastEventSeq Int       @default(0)
  expiresAt    DateTime
  endedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device              @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  events VoiceSessionEvent[]
  audio  AudioAsset[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([deviceId, state])
  /// The expiry sweep reads this.
  @@index([expiresAt])
  @@map("voice_sessions")
}

/// Append-only log of what a session emitted.
///
/// This is what makes reconnection work without replaying the pipeline: a
/// client that dropped at sequence 4 asks for everything after 4. Partial
/// transcripts are deliberately absent — they are pushed live and are not
/// worth a row, nor worth keeping.
model VoiceSessionEvent {
  id             String @id @default(uuid()) @db.Uuid
  voiceSessionId String @db.Uuid
  /// Monotonic within a session, starting at 1.
  seq            Int
  type           String @db.VarChar(40)
  /// Event payload as it was sent to the client.
  payload        Json

  createdAt DateTime @default(now())

  session VoiceSession @relation(fields: [voiceSessionId], references: [id], onDelete: Cascade)

  @@unique([voiceSessionId, seq])
  @@index([voiceSessionId, seq])
  @@map("voice_session_events")
}

/// Metadata for a recording. The bytes are not here.
///
/// Audio lives on disk under a server-generated name and is deleted as soon
/// as it has been transcribed, unless the user asked for something else.
/// `storageKey` is null once the bytes are gone, so a row can say "this
/// existed and was deleted" without implying the audio is still readable.
model AudioAsset {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String  @db.Uuid
  voiceSessionId String? @db.Uuid

  kind       AudioKind @default(INPUT)
  mimeType   String    @db.VarChar(80)
  /// Extension-free opaque name on disk. Null once deleted.
  storageKey String?   @db.VarChar(128)
  byteSize   Int
  durationMs Int?
  sampleRate Int?
  /// SHA-256 of the bytes, so a duplicate upload is recognisable and an
  /// integrity problem is detectable without keeping the audio.
  checksum   String    @db.VarChar(64)

  retention   AudioRetention @default(DISCARD)
  /// When the retention sweep may remove it. Null means "at end of use".
  deleteAfter DateTime?
  deletedAt   DateTime?

  createdAt DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  session VoiceSession? @relation(fields: [voiceSessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([deletedAt])
  @@index([deleteAfter])
  @@map("audio_assets")
}

model Note {
  id      String  @id @default(uuid()) @db.Uuid
  userId  String  @db.Uuid
  /// Optional. A dictated note usually has none, and inventing one from the
  /// first few words would put the assistant's guess in the user's data.
  title   String? @db.VarChar(200)
  content String
  pinned  Boolean @default(false)

  source   NoteSource @default(MANUAL)
  /// BCP-47 tag of what the note is written in, as detected at the time.
  /// Null when nothing detected it — not defaulted to English.
  language String?    @db.VarChar(24)

  /// Client-generated id. Lets an offline device create a note and lets the
  /// existing browser-stored notes import exactly once.
  clientId          String? @db.VarChar(64)
  /// Incremented on every accepted change. The client sends the version it
  /// based its edit on, and a mismatch is a conflict rather than an
  /// overwrite — see `docs/sync-and-scheduling.md`.
  version           Int     @default(1)
  /// The device that last changed it, so a client can tell its own echo
  /// from somebody else's edit.
  updatedByDeviceId String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete. A deletion is a change like any other and has to travel
  /// to the other devices, which it cannot do if the row is gone.
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId, deletedAt, updatedAt(sort: Desc)])
  /// The incremental sync query: everything this user changed since a point.
  @@index([userId, updatedAt(sort: Asc)])
  @@index([userId, pinned, deletedAt])
  @@map("notes")
}

model Reminder {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  text   String

  /// The next moment this should fire, as an instant. Always UTC in the
  /// database; the wall-clock reading is derived from `timezone`.
  dueAt    DateTime
  /// The user's zone at the time the reminder was made, stored alongside
  /// the instant so a recurring reminder keeps firing at the right
  /// wall-clock time across a DST change — and so the two never disagree
  /// about what "9am" meant.
  timezone String   @default("Asia/Kolkata") @db.VarChar(64)
  /// RFC 5545 recurrence rule, null for one-off reminders.
  rrule    String?  @db.VarChar(200)

  status  ReminderStatus @default(SCHEDULED)
  /// Queue job handle, so rescheduling can cancel the previous job and so
  /// the reconciliation sweep can tell a scheduled reminder from one whose
  /// job was lost.
  jobId   String?        @db.VarChar(100)
  firedAt DateTime?

  completedAt  DateTime?
  /// Set while snoozed. `dueAt` moves with it; this records that the move
  /// was a snooze rather than an edit.
  snoozedUntil DateTime?
  snoozeCount  Int       @default(0)

  clientId          String? @db.VarChar(64)
  version           Int     @default(1)
  updatedByDeviceId String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurrences ReminderOccurrence[]

  @@unique([userId, clientId])
  @@index([userId, status, dueAt])
  @@index([status, dueAt])
  @@index([userId, updatedAt(sort: Asc)])
  @@map("reminders")
}

/// One firing of a reminder.
///
/// Recurring reminders need this: a weekly reminder is one row with an
/// rrule, and "did Monday's go out?" is a question about an occurrence, not
/// about the reminder. It is also what makes delivery history honest — the
/// row says a notification was created, and the notification says what
/// became of it.
model ReminderOccurrence {
  id         String @id @default(uuid()) @db.Uuid
  reminderId String @db.Uuid
  userId     String @db.Uuid

  /// The instant this occurrence was for. Unique per reminder, which is
  /// what stops a retry or a restart firing the same occurrence twice.
  scheduledFor DateTime
  status       OccurrenceStatus @default(SCHEDULED)

  firedAt        DateTime?
  notificationId String?   @db.Uuid
  /// Normalised code. Never a provider message.
  failureCode    String?   @db.VarChar(40)

  createdAt DateTime @default(now())

  reminder Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The deduplication guarantee: one occurrence per reminder per instant.
  @@unique([reminderId, scheduledFor])
  @@index([userId, scheduledFor(sort: Desc)])
  @@index([status, scheduledFor])
  @@map("reminder_occurrences")
}

/// An authorised third-party account.
///
/// Tokens are stored as ciphertext only and are never serialised into an API
/// response. `keyVersion` exists so the encryption key can be rotated without
/// a migration.
model ConnectedAccount {
  id       String             @id @default(uuid()) @db.Uuid
  userId   String             @db.Uuid
  provider ConnectionProvider

  /// The account identifier at the provider, for display and reconciliation.
  externalAccountId String?  @db.VarChar(200)
  displayName       String?  @db.VarChar(200)
  scopes            String[]

  accessTokenEnc  Bytes?
  refreshTokenEnc Bytes?
  keyVersion      Int       @default(1)
  expiresAt       DateTime?

  status        ConnectionStatus @default(CONNECTED)
  /// Normalised code, e.g. `refresh_rejected`. Never a provider message.
  lastErrorCode String?          @db.VarChar(40)
  lastError     String?
  revokedAt     DateTime?

  /// Refresh bookkeeping, so the refresh job can back off a connection the
  /// provider keeps rejecting rather than retrying it every few minutes.
  lastRefreshAt   DateTime?
  refreshFailures Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One live connection per provider per user; revoked rows may accumulate.
  @@unique([userId, provider, revokedAt])
  @@index([userId, status])
  /// The refresh sweep reads this.
  @@index([status, expiresAt])
  @@map("connected_accounts")
}

/// One row per user. Grouped documents rather than a column per setting,
/// because the frontend already treats these as three cohesive objects and
/// they change shape as features land.
/// One in-flight OAuth authorisation.
///
/// Stored server-side rather than signed into the state parameter for two
/// reasons: it can be consumed exactly once, which is what makes a replayed
/// callback harmless; and the PKCE verifier has to be kept somewhere the
/// browser never sees.
///
/// Rows are short-lived and swept. A consumed or expired row is kept briefly
/// so a replay can be told apart from a forgery in the audit log.
model OAuthState {
  id String @id @default(uuid()) @db.Uuid

  /// The opaque value that travels in the authorisation URL. Unique, so a
  /// callback either matches exactly one in-flight request or none.
  state String @unique @db.VarChar(64)

  userId   String             @db.Uuid
  /// The device that started it. A callback is only accepted for the
  /// session that began the flow.
  deviceId String             @db.Uuid
  provider ConnectionProvider

  /// PKCE verifier, sealed. It must be presented to the token endpoint, so
  /// it cannot be hashed — and it must never reach the browser, so it
  /// cannot live in the state parameter.
  codeVerifierEnc Bytes?
  keyVersion      Int    @default(1)

  redirectUri String   @db.VarChar(500)
  scopes      String[]

  expiresAt  DateTime
  consumedAt DateTime?

  ipAddress String? @db.Inet
  userAgent String?

  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("oauth_states")
}

model UserPreference {
  userId String @id @db.Uuid

  /// Spoken replies, confirmation timeout, assistant behaviour.
  assistant  Json @default("{}")
  /// Speech source, language, retention choices.
  voice      Json @default("{}")
  /// Orb palette, shape, size, glow, transparency, rim, motion.
  appearance Json @default("{}")
  /// Audio retention and telemetry consent.
  privacy    Json @default("{}")

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Notification {
  id       String  @id @default(uuid()) @db.Uuid
  userId   String  @db.Uuid
  deviceId String? @db.Uuid

  channel NotificationChannel @default(PUSH)
  type    String              @db.VarChar(60)
  title   String              @db.VarChar(200)
  body    String?
  /// Routing payload for the client (deep link, entity ids).
  payload Json?

  status       NotificationStatus @default(QUEUED)
  /// How many times a transport has been asked to take this.
  attemptCount Int                @default(0)
  /// Which provider accepted it, and its handle, where there is one.
  providerId   String?            @db.VarChar(40)
  providerRef  String?            @db.VarChar(200)

  /// Caller-supplied. What stops one reminder occurrence producing two
  /// notifications when a job is retried or a worker restarts.
  ///
  /// Unique **per account**, not globally: a global constraint would let one
  /// user's key collide with another's, and the collision handler would
  /// then hand back a notification belonging to someone else.
  dedupeKey String? @db.VarChar(200)

  /// Accepted by a transport. Deliberately not called `deliveredAt`: we
  /// know it was taken, not that it arrived.
  sentAt        DateTime?
  readAt        DateTime?
  /// Normalised code, e.g. `no_transport`. Never a provider message.
  failureCode   String?   @db.VarChar(40)
  failureReason String?

  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@index([status, createdAt])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

/// What a device has already seen.
///
/// One row per device, holding the watermark an incremental sync reads from.
/// Kept server-side as well as on the client because a reinstalled app has
/// forgotten its cursor and needs somewhere to ask, and because a cursor the
/// server issued is one the server can reason about.
model SyncCursor {
  userId   String @db.Uuid
  deviceId String @db.Uuid

  /// The high-water mark from the last successful pull. Everything changed
  /// at or after this is what the device has not seen.
  notesCursor     DateTime?
  remindersCursor DateTime?

  /// Bookkeeping, for the user's own "last synced" display.
  lastPulledAt DateTime?
  lastPushedAt DateTime?
  /// How many records the device has pushed in total. Diagnostics only.
  pushedCount  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([userId, deviceId])
  @@index([userId])
  @@map("sync_cursors")
}

/// Append-only. No update or delete path exists in application code.
///
/// `userId` is nullable and uses SetNull so that deleting an account
/// pseudonymises the trail rather than erasing the record of what happened.
model AuditLog {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String?   @db.Uuid
  deviceId  String?   @db.Uuid
  actorType ActorType @default(USER)

  action     String  @db.VarChar(80)
  resource   String? @db.VarChar(80)
  resourceId String? @db.VarChar(64)
  /// Request context: correlation id, outcome, non-sensitive parameters.
  metadata   Json?

  ipAddress String? @db.Inet
  userAgent String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([resource, resourceId])
  @@map("audit_logs")
}
