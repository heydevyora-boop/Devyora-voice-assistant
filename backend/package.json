{
  "name": "@devyora/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Devyora central backend \u2014 one assistant, one backend, many platforms.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "db:seed": "ts-node prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.4.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-express": "12.4.0",
    "@nestjs/swagger": "12.1.1",
    "@nestjs/terminus": "12.1.0",
    "@prisma/client": "6.19.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "helmet": "8.3.0",
    "nestjs-pino": "5.3.1",
    "pino": "10.1.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@nestjs/cli": "12.0.12",
    "@nestjs/testing": "12.4.0",
    "@swc/core": "^1.16.22",
    "@types/express": "5.0.0",
    "@types/node": "22.9.0",
    "@types/supertest": "6.0.2",
    "eslint": "9.17.0",
    "globals": "15.14.0",
    "pino-pretty": "13.0.0",
    "prettier": "3.4.2",
    "prisma": "6.19.3",
    "supertest": "7.0.0",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.2",
    "unplugin-swc": "^1.6.0",
    "vitest": "^2.1.9"
  }
}
