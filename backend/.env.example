# ─────────────────────────────────────────────────────────────────────
# Devyora backend — example environment.
# Copy to `.env` and fill in. NEVER commit a real .env.
# Every value below is a placeholder, not a working credential.
# ─────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=3000
# Comma-separated list, or * in development only.
CORS_ORIGINS=http://localhost:5173
API_PREFIX=api
API_VERSION=1

# Database
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://devyora:change-me@localhost:5432/devyora?schema=public

# Logging — fatal | error | warn | info | debug | trace
LOG_LEVEL=debug
# Pretty-print logs locally; always false in production.
LOG_PRETTY=true

# Documentation
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# ── AI provider ──
# mock | openai | gemini. Without a credential for the chosen provider the
# service falls back to the local deterministic stand-in and logs that it
# has done so; responses are then NOT from a language model.
AI_PROVIDER=mock
AI_TIMEOUT_MS=20000
AI_MAX_ATTEMPTS=3
AI_CONTEXT_MESSAGES=10

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Speech recognition ──
# mock | whisper | google. `whisper` talks to any Whisper-compatible
# endpoint: point STT_BASE_URL at a server you run yourself and no key is
# needed. Without a credential for the chosen provider the registry selects
# the local stand-in and logs that it has done so; NO SPEECH is then
# recognised and every transcript is labelled as scripted.
STT_PROVIDER=mock
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1
STT_TIMEOUT_MS=30000
STT_MAX_ATTEMPTS=2
GOOGLE_SPEECH_API_KEY=
GOOGLE_SPEECH_MODEL=latest_short

# ── Speech synthesis ──
# A failure here never costs the text reply. With `mock`, replies are not
# spoken at all.
TTS_PROVIDER=mock
TTS_TIMEOUT_MS=20000
TTS_MODEL=gpt-4o-mini-tts
TTS_DEFAULT_VOICE=alloy
GOOGLE_TTS_API_KEY=

# ── Audio handling ──
# Recordings are deleted as soon as they have been transcribed. Retention
# beyond that is opt-in, per user.
AUDIO_MAX_BYTES=10485760
AUDIO_MAX_DURATION_MS=120000
AUDIO_MIN_BYTES=512
AUDIO_TEMP_DIR=/tmp/devyora-audio
AUDIO_RETENTION_DEFAULT=DISCARD
AUDIO_RETENTION_DAYS=7

# ── Action execution ──
# A handler that overruns ACTION_TIMEOUT_MS is aborted and its outcome is
# reported as UNVERIFIED, not FAILED: a timeout does not tell us whether the
# work had an effect first, and saying "it failed" would be the comfortable
# lie rather than the true answer.
ACTION_TIMEOUT_MS=20000
ACTION_STALE_CLAIM_MS=120000
ACTION_CONFIRMATION_TTL_MS=90000

# ── Push notifications ──
# Without a credential there is no push transport: notifications still land
# in-app, and anything that cannot be delivered is recorded as undeliverable
# rather than reported as sent.
PUSH_PREFERRED=fcm,apns
PUSH_TIMEOUT_MS=10000
# The whole service-account JSON document, as one line.
FCM_SERVICE_ACCOUNT=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY=
APNS_SANDBOX=false

# ── Background work ──
# Whether this instance installs the recurring maintenance schedule. Set
# false on instances that should only serve requests.
JOBS_MAINTENANCE_ENABLED=true

# ── Reminders and sync ──
# Zone for an account that has not set one.
DEFAULT_TIMEZONE=Asia/Kolkata
# How long a deleted note or reminder is kept. Also the longest a device may
# be offline and still learn that something was deleted.
SYNC_TOMBSTONE_DAYS=30
SYNC_MAX_BATCH=200
REMINDER_UPCOMING_DAYS=30

# ── Third-party integrations ──
# No credential is required for any of these. Without one, the official
# connector reports itself unconfigured and a user cannot start its OAuth
# flow — the user-assisted connector, which needs no account, still works
# for WhatsApp, Telegram and email drafts.
#
# Credentials at rest are encrypted with TOKEN_ENCRYPTION_KEY (see below).
# Without that key, connecting ANY third-party account is refused outright
# rather than storing a token unencrypted.
INTEGRATION_REDIRECT_BASE_URL=http://localhost:3000/api/v1/integrations/callback
INTEGRATION_TIMEOUT_MS=15000
INTEGRATION_REFRESH_LEAD_MS=300000

# Gmail and Google Calendar. Both use this one OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# WhatsApp Business Platform, Instagram messaging, Facebook Messenger — one
# Meta app. Every scope here is Advanced Access and needs App Review before
# it works for anyone without a role on the app.
META_APP_ID=
META_APP_SECRET=
# The business phone number WhatsApp sends from. Required specifically for
# WhatsApp, on top of the app credentials above — without it there is
# nothing to send from, so the connector stays unconfigured even with a
# valid app id and secret.
WHATSAPP_PHONE_NUMBER_ID=

# Telegram needs no app registration here at all: each user supplies their
# own bot token from BotFather when they connect, verified against the
# provider before it is stored.

# ── Voice sessions ──
VOICE_SESSION_TTL_MS=300000
VOICE_SESSION_GRACE_MS=900000

# ── Reserved for later chunks. Unset is valid; the app boots without them. ──

# Authentication. REQUIRED — the service refuses to sign tokens without
# these, and each must be at least 32 characters.
# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=10m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=30d

# Chunk 6 — Redis and background jobs
# Durable scheduling. Without it, reminders are stored but never delivered,
# and the readiness probe says so rather than letting it pass unnoticed.
REDIS_URL=

# Encryption for third-party credentials at rest (AES-256-GCM). Without
# this, connecting any third-party account is refused outright rather than
# storing a token unencrypted.
#
# A bare 32-byte base64 key is read as version 1:
#   TOKEN_ENCRYPTION_KEY=<base64 of 32 random bytes>
# Generate one with: openssl rand -base64 32
#
# Several versions may be given, comma-separated, newest first — the
# highest version seals new credentials, and every version is kept for
# reading old ones, so rotating is adding a key, not replacing one:
#   TOKEN_ENCRYPTION_KEY=2:<new key>,1:<old key>
TOKEN_ENCRYPTION_KEY=
